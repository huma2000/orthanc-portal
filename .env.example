# =====================================================================
#  Orthanc Portal - start-up values
#
#  MOST SETTINGS ARE NOW CHANGED FROM THE WEB INTERFACE
#  (sign in as an administrator on the intranet > Settings).
#
#  Only three things are real start-up settings, because they are needed before
#  the database can be read:
#     DATABASE_PATH      where the SQLite file lives
#     ADMIN_USERNAME / ADMIN_PASSWORD   the first administrator (only if no users yet)
#     RESET_SETTINGS     recovery switch (see below)
#
#  Every other variable in this file is just the INITIAL VALUE of a setting.
#  It is used until an administrator saves the Settings form; after that the
#  saved value wins and the variable is ignored. You can delete them all and
#  configure everything in the browser.
#
#  Copy this file to ".env" (same folder as the executable) and edit it.
#  Real environment variables always win over the .env file.
# =====================================================================

# --- Start-up settings (not editable from the web) --------------------------
# SQLite file with users, audit log, transfers AND the settings saved from the web.
# It also stores the Orthanc password: protect this file like you would a .env.
DATABASE_PATH=portal.db
# First administrator, created ONLY when the user table is empty.
# If ADMIN_PASSWORD is empty a random one is generated and printed once in the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# RECOVERY: set to true for ONE start to throw away the settings saved from the web
# (for example after typing a wrong port) and go back to the values below.
# Users, audit log and transfers are NOT touched. Remove it afterwards.
RESET_SETTINGS=false

# =====================================================================
#  INITIAL VALUES of settings editable from the web interface
# =====================================================================

# --- Web server: TWO listeners --------------------------------------------
# 1) INTRANET listener: every feature (upload, download, send, admin...), each
#    limited by the user's permissions. Never expose this port to the internet.
BIND_ADDR=0.0.0.0:8080
# 2) INTERNET listener: serves ONLY invitation (share) links. A staff member
#    creates a link + password for ONE study from the intranet; the guest opens
#    the link, types the password, and can view that study in OHIF and download
#    it as a ZIP (as many times as the link allows). There are no accounts,
#    search or admin on this port. Point your Cloudflare Tunnel at THIS port and
#    type the public address in Settings > Share links. Use "off" to disable it.
REMOTE_BIND_ADDR=0.0.0.0:8081

# --- Orthanc ----------------------------------------------------------
# REST API of your Orthanc server (release 1.12.5 or newer), as seen from the
# machine running the portal.
ORTHANC_URL=http://localhost:8042
# Credentials of the Orthanc account the portal uses (Orthanc "RegisteredUsers").
# Leave both empty if your Orthanc has no authentication (not recommended).
ORTHANC_USERNAME=portal
ORTHANC_PASSWORD=change-me

# --- Links given to Weasis ---------------------------------------------
# Leave EMPTY to auto-detect: each user gets a link matching the address they
# used (intranet IP/name or Cloudflare hostname). Set it only to force a single
# public address, e.g. https://pacs.example.com
PUBLIC_BASE_URL=

# --- Sessions and limits ----------------------------------------------
# Hours a login stays valid.
SESSION_HOURS=12
# Minutes a Weasis access token stays valid (Weasis keeps loading images with it).
WEASIS_TOKEN_MINUTES=240
# Largest single file accepted by the upload endpoint, in megabytes.
# NOTE: Cloudflare itself limits each request to 100 MB on Free/Pro plans.
MAX_UPLOAD_MB=2048

# --- Cookies ------------------------------------------------------------
# auto  = add the "Secure" flag only when the request came over HTTPS (default,
#         right for "intranet over http + internet over Cloudflare https")
# true  = always Secure (only if you serve HTTPS everywhere)
# false = never Secure
COOKIE_SECURE=auto

# --- OHIF web viewer ---------------------------------------------------------
# auto  = show the "browser viewer" button when Orthanc reports its OHIF plugin
# true  = always show it      false = never show it
OHIF_ENABLED=auto

# --- Logging ------------------------------------------------------------
# error | warn | info | debug | trace
RUST_LOG=info
