# =====================================================================
#  Orthanc + Orthanc Portal + Cloudflare Tunnel (docker-compose.yml in this folder)
#  Copy this file to ".env" (same folder as docker-compose.yml) and fill it in.
# =====================================================================

# --- Password of the Orthanc account the portal uses (REQUIRED) -------------
# Choose a long random one. Orthanc (orthanc.json reads it from here) and the portal
# both use it: there is nothing else to edit. Orthanc itself is never published: only
# the portal can reach it, with this account.
ORTHANC_PORTAL_PASSWORD=

# --- Cloudflare Tunnel (REQUIRED: this is how the internet reaches invitation links) --
# Cloudflare Zero Trust > Networks > Tunnels > create a tunnel (type "Cloudflared") and
# copy its token here. Then add a public hostname pointing to  HTTP  portal:8081
# (README, section 10). For an intranet-only install remove the cloudflared service
# from docker-compose.yml instead.
TUNNEL_TOKEN=

# --- First administrator of the portal --------------------------------------
# Created only when the portal has no users yet. Empty = a random password is
# generated and printed once in the log:  docker compose logs portal
ADMIN_PASSWORD=

# --- Ports (change only if another program already uses them) -----------------
# Staff portal, published on this server: http://<this-server>:<INTRANET_PORT>
# INTRANET_BIND 0.0.0.0 = reachable from the whole intranet. Never forward it to the internet.
INTRANET_BIND=0.0.0.0
INTRANET_PORT=8080
# Invitation links. NOT published on this server: only the cloudflared container uses it,
# so a conflict is impossible and you rarely need to change it. If you do, the tunnel's
# public hostname in Cloudflare must point to  HTTP  portal:<INTERNET_PORT>.
INTERNET_PORT=8081
# DICOM port of Orthanc, published for your scanners / modalities.
DICOM_PORT=4242
