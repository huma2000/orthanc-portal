# =====================================================================
#  Orthanc Portal + Cloudflare Tunnel, for an Orthanc you already have
#  (docker-compose.yml in this folder)
#  Copy this file to ".env" (same folder as docker-compose.yml) and edit it.
#
#  The portal values are INITIAL values: they are read the first time the portal
#  starts and then live in the portal's database. Afterwards change them in the
#  browser (sign in as an administrator > Settings). Editing this file later does
#  not change an already-running portal (see RESET_SETTINGS in the README).
# =====================================================================

# --- Your existing Orthanc (REQUIRED) -------------------------------------
# REST API address of Orthanc (release 1.12.5 or newer), as seen FROM THE
# CONTAINER. Examples:
#   http://192.168.1.50:8042            Orthanc on another computer
#   http://host.docker.internal:8042    Orthanc on this same computer
#   http://orthanc:8042                 Orthanc container on a shared Docker network
ORTHANC_URL=http://192.168.1.50:8042

# --- Orthanc account (OPTIONAL) -------------------------------------------
# With users:    fill both in (an entry of "RegisteredUsers" in Orthanc's configuration).
# Without users: leave BOTH EMPTY. The portal then sends no credentials, and Orthanc
#                (or the reverse proxy in front of it) must accept this server's
#                address in its list of allowed clients / IPs.
ORTHANC_USERNAME=
ORTHANC_PASSWORD=

# --- Cloudflare Tunnel (REQUIRED: this is how the internet reaches invitation links) --
# Cloudflare Zero Trust > Networks > Tunnels > create a tunnel (type "Cloudflared") and
# copy its token here. Then add a public hostname pointing to  HTTP  portal:8081
# (README, section 10). For an intranet-only install remove the cloudflared service
# from docker-compose.yml instead.
TUNNEL_TOKEN=

# --- First administrator of the portal --------------------------------------
# Created only when the portal has no users yet. Empty = a random password is
# generated and printed once in the log:  docker compose logs portal
ADMIN_PASSWORD=

# --- Published port (change only if the default is taken) --------------------
# Staff portal. 0.0.0.0 = reachable from the whole intranet.
# (The invitation-links port is never published: only the tunnel container uses it.)
INTRANET_BIND=0.0.0.0
INTRANET_PORT=8080
